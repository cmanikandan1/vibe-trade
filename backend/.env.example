# LLM: VibeTrade calls Claude models via Amazon Bedrock.
# AWS credentials are read from the default credential chain
# (env vars / ~/.aws/credentials / SSO / IAM role / etc.) — do NOT hardcode keys here.
# Override the target region (optional, default: us-east-1):
# AWS_REGION=us-east-1

# Bedrock runtime overrides (all optional — configurable in the UI too):
# BEDROCK_GEOGRAPHY=us              # us | eu | apac
# BEDROCK_REASONING_MODEL=claude-sonnet-4-5
# BEDROCK_EVALUATION_MODEL=claude-haiku-4-5

DHAN_CLIENT_ID=your_client_id
DHAN_ACCESS_TOKEN=your_access_token
PORT=3001
